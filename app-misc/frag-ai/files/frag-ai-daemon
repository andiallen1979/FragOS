                self._json({"error": "Project not found"}, 404); return
            if data.get("archive_first", True):
                os.makedirs(cfg["archive_root"], exist_ok=True)
                arch_path = os.path.join(cfg["archive_root"], f"{project}_deleted_{time.strftime('%Y%m%d-%H%M%S')}.tar.gz")
                with tarfile.open(arch_path, "w:gz") as tf:
                    tf.add(pdir, arcname=project)
