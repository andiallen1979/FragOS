            custom, removed = [], []
            if os.path.isfile(PRESETS_FILE):
                try:
                    raw = json.load(open(PRESETS_FILE, encoding="utf-8"))
                    custom = raw.get("custom", [])
                    removed = raw.get("removed", [])
                except Exception:
                    pass
            custom = [p for p in custom if p.get("id") != pid]
            if any(p["id"] == pid for p in DEFAULT_PRESETS) and pid not in removed:
                removed.append(pid)
            save_presets_state(custom, removed)
            cfg = load_studio_cfg()
            if cfg.get("active_preset") == pid:
                cfg["active_preset"] = ""
                cfg.pop("active_preset_data", None)
                save_studio_cfg(cfg)
            self._json({"ok": True, "removed_id": pid}); return
        if self.path == "/api/online-models/config":
            cfg = load_studio_cfg()
            cfg["online_models"] = data
            save_studio_cfg(cfg)
            self._json({"ok": True, "online_models": cfg["online_models"]}); return
        if self.path == "/api/projects/create-boilerplate":
