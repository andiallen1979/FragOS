            if not project or not os.path.isdir(pdir):
                self._json({"error": "Project not found"}, 404); return
            pkg_out = os.path.join(cfg["archive_root"], "packages")
            os.makedirs(pkg_out, exist_ok=True)
            tar_path = os.path.join(pkg_out, f"{project}-{version}.tar.gz")
            with tarfile.open(tar_path, "w:gz") as tf:
                tf.add(pdir, arcname=f"{project}-{version}")
            repo_dir = os.path.expanduser(cfg["repo_dir"])
            staged_files = []
            pkg_rel = (data.get("pkg_rel") or cfg.get("default_pkg") or "").strip("/")
            if pkg_rel and os.path.isdir(repo_dir):
                files_dir = os.path.join(repo_dir, pkg_rel, "files")
                os.makedirs(files_dir, exist_ok=True)
                for fn in os.listdir(pdir):
                    fp = os.path.join(pdir, fn)
                    if os.path.isfile(fp):
                        tp = os.path.join(files_dir, fn)
                        shutil.copy2(fp, tp)
                        staged_files.append(tp)
            self._json({"ok": True, "package": tar_path, "staged": staged_files}); return
        if self.path == "/api/projects/push":
            cfg = load_studio_cfg()
            repo_dir = os.path.expanduser(cfg["repo_dir"])
            msg = (data.get("message") or f"code-studio: update {data.get('project') or 'workspace'}").strip()
            if not os.path.isdir(repo_dir):
                self._json({"error": f"Repo directory missing: {repo_dir}"}, 400); return
            cmds = [
                ["git", "-C", repo_dir, "add", "-A"],
                ["git", "-C", repo_dir, "commit", "-m", msg],
                ["git", "-C", repo_dir, "push", cfg.get("repo_remote", "origin"), cfg.get("repo_branch", "main")],
            ]
            logs = []
            for c in cmds:
                res = subprocess.run(c, capture_output=True, text=True)
                logs.append({"cmd": " ".join(c), "rc": res.returncode, "out": (res.stdout + res.stderr).strip()})
                if c[2] == "commit" and res.returncode != 0 and "nothing to commit" in (res.stdout + res.stderr).lower():
                    continue
                if res.returncode != 0 and c[2] != "commit":
                    self._json({"ok": False, "error": res.stderr or res.stdout, "logs": logs}, 500); return
            self._json({"ok": True, "logs": logs}); return
        if self.path == "/api/projects/archive":
            cfg = load_studio_cfg()
            project = os.path.basename(data.get("project") or "")
            version = (data.get("version") or time.strftime("%Y%m%d-%H%M%S")).strip()
            pdir = os.path.abspath(os.path.join(cfg["code_root"], project))
            if not project or not os.path.isdir(pdir):
                self._json({"error": "Project not found"}, 404); return
