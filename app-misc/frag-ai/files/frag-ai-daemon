def project_pro_path(code_root, project_name):
    safe = os.path.basename(project_name)
    return os.path.join(code_root, safe, f"{safe}.frag_pro")

def load_project_meta(code_root, project_name, global_cfg):
    safe = os.path.basename(project_name)
    pdir = os.path.join(code_root, safe)
    pro_file = project_pro_path(code_root, safe)
    meta = {
        "name": safe,
        "pro_file": f"{safe}/{safe}.frag_pro",
        "version": "1.0.0",
        "repo_dir": global_cfg.get("repo_dir", os.path.expanduser("~/FragOS")),
        "pkg_target": global_cfg.get("default_pkg", "app-misc/frag-ai"),
        "auto_push": bool(global_cfg.get("auto_push", False)),
    }
    if os.path.isfile(pro_file):
        try:
            with open(pro_file, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                if isinstance(loaded, dict):
                    meta.update({k: v for k, v in loaded.items() if k in ("version", "repo_dir", "pkg_target", "auto_push")})
        except Exception:
            pass
    elif os.path.isdir(pdir):
        save_project_meta(code_root, safe, meta)
    return meta

def save_project_meta(code_root, project_name, meta):
    safe = os.path.basename(project_name)
    pdir = os.path.join(code_root, safe)
    os.makedirs(pdir, exist_ok=True)
    pro_file = project_pro_path(code_root, safe)
    payload = {
        "format": "frag-project-v1",
        "name": safe,
        "version": meta.get("version", "1.0.0"),
        "repo_dir": meta.get("repo_dir", os.path.expanduser("~/FragOS")),
        "pkg_target": meta.get("pkg_target", "app-misc/frag-ai"),
        "auto_push": bool(meta.get("auto_push", False)),
    }
    with open(pro_file, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2)
    return payload

