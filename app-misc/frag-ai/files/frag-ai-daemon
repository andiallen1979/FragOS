def expand_target(raw_path: str) -> str:
    p = (raw_path or "").strip()
    if not p: return os.path.join(DEFAULT_CWD, "script.py")
    if p == "~" or p.startswith("~/"): p = USER_HOME + p[1:]
    if not os.path.isabs(p): p = os.path.join(DEFAULT_CWD, p)
    return os.path.abspath(p)

def safe_in_code(rel_path: str) -> str:
    base = os.path.abspath(DEFAULT_CWD)
    target = os.path.abspath(os.path.join(base, rel_path.lstrip("/")))
    if not (target == base or target.startswith(base + os.sep)):
        raise ValueError("Path outside ~/.code")
    return target

def list_tree(root: str):
    items = []
    os.makedirs(root, exist_ok=True)
    for entry in sorted(os.scandir(root), key=lambda e: (not e.is_dir(), e.name.lower())):
        if entry.name.startswith(".") or entry.name == "__pycache__": continue
        rel = os.path.relpath(entry.path, DEFAULT_CWD)
        if entry.is_dir():
            items.append({"name": entry.name, "rel": rel, "type": "dir", "children": list_tree(entry.path)})
        else:
            items.append({"name": entry.name, "rel": rel, "path": entry.path, "type": "file"})
    return items

def save_file(target: str, code: str):
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as f: f.write(code.rstrip() + "\n")
        os.chmod(target, 0o664)
        return True, f"Saved {len(code)} bytes to {target}"
    except PermissionError:
        os.makedirs(STAGED_DIR, exist_ok=True)
        staged = os.path.join(STAGED_DIR, f"{int(time.time())}_{os.path.basename(target)}")
        with open(staged, "w", encoding="utf-8") as f: f.write(code.rstrip() + "\n")
        return False, f"Permission denied. Staged:\nsudo install -D -m 644 {shlex.quote(staged)} {shlex.quote(target)}"



CATALOG_CACHE = os.path.expanduser("~/.cache/frag-ai/catalog.json")

def fetch_catalog(force=False):
    os.makedirs(os.path.dirname(CATALOG_CACHE), exist_ok=True)
    if not force and os.path.exists(CATALOG_CACHE):
        import time
        if time.time() - os.path.getmtime(CATALOG_CACHE) < 86400:
            try: return json.load(open(CATALOG_CACHE))
            except Exception: pass
    models = []
    try:
        req = urllib.request.Request(
            "https://ollamadb.dev/api/v1/models?model_type=official&sort_by=pulls&limit=100",
            headers={"User-Agent": "Frag-MM/1.1"}
        )
        raw = json.loads(urllib.request.urlopen(req, timeout=12).read().decode())
        for m in raw.get("models", []):
            models.append({
                "name": m.get("model_name") or m.get("model_identifier", ""),
                "desc": (m.get("description") or "")[:160],
                "tags": m.get("labels") or [],
                "cap": m.get("capability") or ""
            })
    except Exception:
        # Fallback: lightweight parse of ollama.com/library
        import re
        html = urllib.request.urlopen("https://ollama.com/library", timeout=12).read().decode("utf-8", "replace")
        for slug, desc in re.findall(r'href="/library/([^"]+)"[^>]*>.*?<p[^>]*>([^<]+)</p>', html, re.S)[:80]:
            models.append({"name": slug.strip(), "desc": " ".join(desc.split())[:160], "tags": [], "cap": ""})
    if models:
        json.dump(models, open(CATALOG_CACHE, "w"))
    return models

def recommend_models(prompt_text, helper_model=""):
    hw = get_hw_info()
    catalog = fetch_catalog()
    if not helper_model:
        tags = json.loads(urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=10).read().decode()).get("models", [])
        if not tags:
            return {"error": "No local Ollama models installed yet to run the assistant."}
        helper_model = tags[0]["name"]
    compact_cat = "\n".join(f"- {m['name']} ({','.join(m['tags'][:6])}) [{m['cap']}]: {m['desc']}" for m in catalog[:60])
    sys_msg = (
        "You are a local Ollama model selector. Given the user's hardware and goal, pick 3 to 5 best models "
        "from the catalog with exact pullable 'name:tag' strings (e.g. qwen2.5-coder:7b). "
        "Respect VRAM/RAM limits. Reply ONLY with JSON: "
        '{"recommendations":[{"model":"name:tag","reason":"short reason","fit":"VRAM/RAM fit"}]}'
    )
    user_msg = f"Hardware: {hw}\nGoal: {prompt_text}\n\nCatalog:\n{compact_cat}"
    payload = {
        "model": helper_model,
        "format": "json",
        "stream": False,
        "messages": [{"role": "system", "content": sys_msg}, {"role": "user", "content": user_msg}]
    }
    req = urllib.request.Request(f"{OLLAMA_URL}/api/chat", data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"})
    resp = json.loads(urllib.request.urlopen(req, timeout=120).read().decode())
    return json.loads(resp["message"]["content"])

PULL_STATE = {"model": "", "status": "idle", "percent": 0, "done": True, "error": ""}

def get_hw_info():
    ram_gb = 0
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"): ram_gb = round(int(line.split()[1]) / 1048576, 1)
    except Exception: pass
    disk_gb = round(shutil.disk_usage(USER_HOME).free / (1024**3), 1)
    gpu, vram_gb = "CPU/RAM", 0
    try:
        out = subprocess.check_output(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader,nounits"], text=True, timeout=3).strip().splitlines()[0]
        gpu, mb = [x.strip() for x in out.split(",")]
        vram_gb = round(int(mb) / 1024, 1)
    except Exception:
        try:
            vram_gb = round(int(open("/sys/class/drm/card0/device/mem_info_vram_total").read().strip()) / (1024**3), 1)
            gpu = "AMD GPU"
        except Exception: pass
    return {"gpu": gpu, "vram_gb": vram_gb, "ram_gb": ram_gb, "disk_free_gb": disk_gb}

def pull_worker(model):
    PULL_STATE.update({"model": model, "status": "starting...", "percent": 0, "done": False, "error": ""})
    try:
        req = urllib.request.Request(f"{OLLAMA_URL}/api/pull", data=json.dumps({"name": model, "stream": True}).encode(), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=3600) as r:
            for line in r:
                if not line.strip(): continue
                ev = json.loads(line.decode("utf-8", "replace"))
                tot, comp = ev.get("total") or 0, ev.get("completed") or 0
                pct = int((comp / tot) * 100) if tot else PULL_STATE["percent"]
                PULL_STATE.update({"status": ev.get("status", ""), "percent": pct})
        PULL_STATE.update({"status": "completed", "percent": 100, "done": True})
    except Exception as e:
        PULL_STATE.update({"status": "error", "error": str(e), "done": True})

class Handler(BaseHTTPRequestHandler):
    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Token")

    def _send(self, body: bytes, ctype: str, code=200):
        self.send_response(code); self._cors()
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers(); self.wfile.write(body)

    def _json(self, obj, code=200):
        self._send(json.dumps(obj).encode("utf-8"), "application/json", code)

    def do_OPTIONS(self): self.send_response(204); self._cors(); self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        static_map = {
            "/": ("index.html", "text/html; charset=utf-8"),
            "/mm": ("mm.html", "text/html; charset=utf-8"),
            "/media": ("media.html", "text/html; charset=utf-8"),
            "/style.css": ("style.css", "text/css"),
            "/app.js": ("app.js", "application/javascript"),
            "/mm.js": ("mm.js", "application/javascript"),
        }
        if parsed.path in static_map:
            fname, ctype = static_map[parsed.path]
            with open(os.path.join(STUDIO_DIR, fname), "r", encoding="utf-8") as f:
                txt = f.read().replace("__TOKEN__", TOKEN) if fname.endswith(".html") else f.read()
            self._send(txt.encode("utf-8"), ctype); return
        if parsed.path == "/api/models":
            try:
                with urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=10) as r:
                    self._json(json.loads(r.read().decode("utf-8")))
            except Exception as e: self._json({"models": [], "error": str(e)}, 502)
            return
        if self.headers.get("X-Token") != TOKEN: self._json({"error": "forbidden"}, 403); return
        if parsed.path == "/api/mm/catalog":
            try: self._json({"models": fetch_catalog(force="refresh=1" in parsed.query)})
            except Exception as e: self._json({"error": str(e)}, 502)
            return
        if parsed.path == "/api/mm/status":
            try:
                tags = json.loads(urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=10).read().decode())
                ps = json.loads(urllib.request.urlopen(f"{OLLAMA_URL}/api/ps", timeout=10).read().decode())
                self._json({"models": tags.get("models", []), "running": ps.get("models", []), "hw": get_hw_info(), "pull": PULL_STATE})
            except Exception as e: self._json({"error": str(e)}, 502)
            return
        if parsed.path == "/api/mm/pull_status":
            self._json(PULL_STATE); return
        if parsed.path.startswith("/media-files/"):
            rel = parsed.path[len("/media-files/"):].lstrip("/")
            full = os.path.abspath(os.path.join(MEDIA_DIR, rel))
            if not full.startswith(os.path.abspath(MEDIA_DIR)) or not os.path.isfile(full):
                self._json({"error": "not found"}, 404); return
            ctype = {
                ".mp4": "video/mp4",
                ".png": "image/png",
                ".wav": "audio/wav",
                ".json": "application/json",
                ".txt": "text/plain; charset=utf-8",
            }.get(os.path.splitext(full)[1].lower(), "application/octet-stream")
            with open(full, "rb") as f:
                self._send(f.read(), ctype); return
        if parsed.path == "/api/media/jobs":
            os.makedirs(MEDIA_DIR, exist_ok=True)
            jobs = []
            for d in sorted(os.listdir(MEDIA_DIR), reverse=True)[:20]:
                jd = os.path.join(MEDIA_DIR, d)
                if not os.path.isdir(jd): continue
                st_p = os.path.join(jd, "status.json")
                jb_p = os.path.join(jd, "job.json")
                st = json.load(open(st_p, encoding="utf-8")) if os.path.exists(st_p) else {}
                jb = json.load(open(jb_p, encoding="utf-8")) if os.path.exists(jb_p) else {}
                jobs.append({"id": d, "prompt": jb.get("prompt", ""), "mode": jb.get("mode", ""), **st})
            self._json({"jobs": jobs}); return
        if parsed.path == "/api/studio/config":
            self._json(load_studio_cfg()); return
        if parsed.path == "/api/projects":
            cfg = load_studio_cfg()
            root = os.path.abspath(cfg["code_root"])
            os.makedirs(root, exist_ok=True)
            projects = []
            for name in sorted(os.listdir(root)):
                p = os.path.join(root, name)
                if os.path.isdir(p) and not name.startswith("."):
                    meta = load_project_meta(root, name, cfg)
                    files = []
                    for r, _, fs in os.walk(p):
                        for fn in sorted(fs):
                            rel = os.path.relpath(os.path.join(r, fn), root)
                            files.append(rel)
                    projects.append({
                        "name": name,
                        "path": p,
                        "pro_file": meta["pro_file"],
                        "version": meta["version"],
                        "repo_dir": meta["repo_dir"],
                        "pkg_target": meta["pkg_target"],
                        "auto_push": meta["auto_push"],
                        "files": files,
                    })
            self._json({"root": root, "projects": projects, "config": cfg}); return
        if parsed.path == "/api/languages":
            self._json({"languages": detect_installed_languages_v2()}); return
        if parsed.path == "/api/project/file-content":
            cfg = load_studio_cfg()
            qs = urllib.parse.parse_qs(parsed.query)
            proj = os.path.basename((qs.get("project") or [""])[0])
            rel = (qs.get("rel") or [""])[0].lstrip("/")
            pdir = os.path.abspath(os.path.join(cfg["code_root"], proj))
            target = os.path.abspath(os.path.join(pdir, rel))
            if not proj or not target.startswith(pdir + os.sep) or not os.path.isfile(target):
                self._json({"error": "File not found"}, 404); return
            with open(target, "r", encoding="utf-8", errors="replace") as f:
                self._json({"ok": True, "project": proj, "rel": rel, "full_path": target, "content": f.read()}); return
        if parsed.path == "/api/tree":
            self._json({"root": DEFAULT_CWD, "tree": list_tree(DEFAULT_CWD)}); return
        if parsed.path == "/api/file":
            rel = (urllib.parse.parse_qs(parsed.query).get("rel") or [""])[0]
            try:
                target = safe_in_code(rel)
                with open(target, "r", encoding="utf-8", errors="replace") as f:
                    self._json({"path": target, "rel": rel, "content": f.read()})
            except Exception as e: self._json({"error": str(e)}, 404)
            return
        self._json({"error": "not found"}, 404)

    def do_POST(self):
        if self.headers.get("X-Token") != TOKEN: self._json({"error": "forbidden"}, 403); return
        data = json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))).decode("utf-8"))
        if self.path == "/api/media/run":
            mode = data.get("mode", "video")
            if mode in ("image", "video", "audio") and not os.path.isfile(MEDIA_PYTHON):
                self._json({"error": "Media runtime is not set up. Run frag-ai-media-setup in your user account, then retry."}, 503); return
            os.makedirs(MEDIA_DIR, exist_ok=True)
            jid = f"job_{time.time_ns()}"
            jd = os.path.join(MEDIA_DIR, jid)
            os.makedirs(jd, exist_ok=True)
            with open(os.path.join(jd, "job.json"), "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            with open(os.path.join(jd, "status.json"), "w", encoding="utf-8") as f:
                json.dump({"stage": "queued", "detail": "Starting worker...", "done": False}, f)
            worker_python = MEDIA_PYTHON if mode in ("image", "video", "audio") else sys.executable
            subprocess.Popen([worker_python, "/usr/libexec/frag-media-worker.py", jd])
            self._json({"ok": True, "job_id": jid}); return
        if self.path == "/api/studio/config":
            cfg = load_studio_cfg()
            for k in ("code_root", "archive_root", "repo_dir", "repo_remote", "repo_branch", "default_pkg", "auto_push"):
                if k in data:
                    cfg[k] = data[k]
            save_studio_cfg(cfg)
            self._json({"ok": True, "config": cfg}); return
        
def _write_starter_boilerplate(pdir, name, lang_id, selected_bin, selected_ver):
