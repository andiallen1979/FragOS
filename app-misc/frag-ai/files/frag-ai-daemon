    }
    fname, content = templates.get(lang, templates["python"])
    target = os.path.join(pdir, fname)
    with open(target, "w", encoding="utf-8") as f:
        f.write(content)
    return fname, content

    if self.path == "/api/projects/create":
        cfg = load_studio_cfg()
        name = os.path.basename((data.get("name") or "").strip())
        if not name:
            self._json({"error": "Project name required"}, 400); return
        pdir = os.path.abspath(os.path.join(cfg["code_root"], name))
        if not pdir.startswith(os.path.abspath(cfg["code_root"]) + os.sep):
            self._json({"error": "Invalid project path"}, 400); return
        os.makedirs(pdir, exist_ok=True)
        save_project_meta(cfg["code_root"], name, {
            "version": (data.get("version") or "1.0.0").strip(),
            "repo_dir": data.get("repo_dir") or cfg.get("repo_dir", os.path.expanduser("~/FragOS")),
            "pkg_target": data.get("pkg_target") or cfg.get("default_pkg", "app-misc/frag-ai"),
            "auto_push": bool(data.get("auto_push", cfg.get("auto_push", False))),
        })
        starter = os.path.join(pdir, "main.py")
        if not os.path.exists(starter):
            with open(starter, "w", encoding="utf-8") as f:
                f.write("#!/usr/bin/env python3\n\ndef main():\n    print('Editing in ~/.code/" + name + "')\n\nif __name__ == '__main__':\n    main()\n")
        self._json({"ok": True, "project": name, "pro_file": f"{name}/{name}.frag_pro"}); return
        if self.path == "/api/projects/meta":
            cfg = load_studio_cfg()
            name = os.path.basename((data.get("project") or "").strip())
            pdir = os.path.abspath(os.path.join(cfg["code_root"], name))
            if not name or not os.path.isdir(pdir):
                self._json({"error": "Project not found"}, 404); return
            cur = load_project_meta(cfg["code_root"], name, cfg)
            for k in ("version", "repo_dir", "pkg_target", "auto_push"):
                if k in data:
                    cur[k] = data[k]
            saved = save_project_meta(cfg["code_root"], name, cur)
            self._json({"ok": True, "project": name, "meta": saved}); return
        if self.path == "/api/projects/assign-file":
            cfg = load_studio_cfg()
            src_rel = (data.get("src_rel") or "").lstrip("/")
            project = os.path.basename(data.get("project") or "")
            target_sub = (data.get("target_sub") or "").lstrip("/")
            repo_target = (data.get("repo_target") or "").lstrip("/")
            src_full = os.path.abspath(os.path.join(cfg["code_root"], src_rel))
            if not src_full.startswith(os.path.abspath(cfg["code_root"])) or not os.path.isfile(src_full):
                self._json({"error": "Source file not found"}, 404); return
            dests = []
            if project:
                p_dest = os.path.abspath(os.path.join(cfg["code_root"], project, target_sub or os.path.basename(src_full)))
                if os.path.isdir(p_dest):
                    p_dest = os.path.join(p_dest, os.path.basename(src_full))
                os.makedirs(os.path.dirname(p_dest), exist_ok=True)
                shutil.copy2(src_full, p_dest)
                dests.append(p_dest)
            if repo_target and os.path.isdir(cfg["repo_dir"]):
                r_dest = os.path.abspath(os.path.join(cfg["repo_dir"], repo_target))
                if r_dest.startswith(os.path.abspath(cfg["repo_dir"])):
                    if os.path.isdir(r_dest):
                        r_dest = os.path.join(r_dest, os.path.basename(src_full))
                    os.makedirs(os.path.dirname(r_dest), exist_ok=True)
