def _probe_version_candidates(cmd_name, bin_path):
    found = []
    # Check versioned binaries on PATH matching cmd_name-* (e.g., python3.12, python3.14, gcc-14, clang-19)
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    seen = set()
    candidates = []
    if bin_path:
        candidates.append((cmd_name, bin_path))
    for d in path_dirs:
        if not os.path.isdir(d):
            continue
        try:
            for fn in sorted(os.listdir(d)):
                if fn == cmd_name or fn.startswith(cmd_name + "-"):
                    fp = os.path.join(d, fn)
                    if os.path.isfile(fp) and os.access(fp, os.X_OK):
                        candidates.append((fn, fp))
        except Exception:
            pass
    for label_bin, fp in candidates:
        real_fp = os.path.realpath(fp)
        if real_fp in seen:
            continue
        seen.add(real_fp)
        ver_line = ""
        try:
            res = subprocess.run([fp, "--version"], capture_output=True, text=True, timeout=2)
            lines = (res.stdout or res.stderr or "").strip().splitlines()
            if lines:
                ver_line = lines[0].strip()[:90]
        except Exception:
            ver_line = label_bin
        found.append({"bin": label_bin, "path": fp, "version": ver_line or label_bin})
    return found

def detect_installed_languages_v2():
    out = []
    for spec in LANGUAGE_PROBES:
        all_cmds = [spec["cmd"]] + spec.get("alt_cmds", [])
        versions = []
        seen_paths = set()
        for c in all_cmds:
            p = shutil.which(c)
            if p:
                for v in _probe_version_candidates(c, p):
                    if v["path"] not in seen_paths:
                        seen_paths.add(v["path"])
                        versions.append(v)
        if not versions:
            continue
        primary = versions[0]
        out.append({
            "id": spec["id"],
            "label": spec["label"],
            "bin": primary["bin"],
            "path": primary["path"],
            "version": primary["version"],
            "versions": versions,
            "starter": spec["starter"],
            "desc": spec["desc"],
        })
    return out

def sync_tracked_files_in_pro(code_root, project_name, global_cfg):
    safe = os.path.basename(project_name)
    pdir = os.path.join(code_root, safe)
    pro_file = project_pro_path(code_root, safe)
    meta = load_project_meta(code_root, safe, global_cfg)
    pro_name = os.path.basename(pro_file)
    disk_files = []
    if os.path.isdir(pdir):
        for r, _, fs in os.walk(pdir):
            for fn in sorted(fs):
                if fn == pro_name:
                    continue
                rel_in_proj = os.path.relpath(os.path.join(r, fn), pdir)
                disk_files.append(rel_in_proj)
    tracked = meta.get("tracked_files")
    if not isinstance(tracked, list):
        tracked = list(disk_files)
    else:
        tracked = [f for f in tracked if f in disk_files]
        for df in disk_files:
            if df not in tracked:
                tracked.append(df)
    meta["tracked_files"] = tracked
    with open(pro_file, "r", encoding="utf-8") as f:
        raw = json.load(f) if os.path.isfile(pro_file) else {}
    raw.update({
        "format": "frag-project-v1",
        "name": safe,
        "version": meta.get("version", "1.0.0"),
        "repo_dir": meta.get("repo_dir", global_cfg.get("repo_dir", os.path.expanduser("~/FragOS"))),
        "pkg_target": meta.get("pkg_target", global_cfg.get("default_pkg", "app-misc/frag-ai")),
        "auto_push": bool(meta.get("auto_push", global_cfg.get("auto_push", False))),
        "tracked_files": tracked,
    })
    with open(pro_file, "w", encoding="utf-8") as f:
        json.dump(raw, f, indent=2)
    return raw

