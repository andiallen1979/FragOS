            f'    return 0;\n'
            f'}}\n',
        ),
        "rust": (
            "main.rs",
            f'fn main() {{\n'
            f'    println!("Hello from {name} ({selected_bin or "rustc"})");\n'
            f'}}\n',
        ),
        "go": (
            "main.go",
            f'package main\n\nimport "fmt"\n\n'
            f'func main() {{\n'
            f'\tfmt.Println("Hello from {name} ({selected_bin or "go"})")\n'
            f'}}\n',
        ),
        "shell": (
            "run.sh",
            f'#!/usr/bin/env {selected_bin or "bash"}\nset -euo pipefail\n\n'
            f'echo "Hello from {name}"\n',
        ),
        "lua": (
            "main.lua",
            f'print("Hello from {name} ({selected_bin or "lua"})")\n',
        ),
        "javascript": (
            "index.js",
            f'console.log("Hello from {name} ({selected_bin or "node"})");\n',
        ),
        "typescript": (
            "index.ts",
