#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

media_env = Path.home() / ".local/share/frag-ai/media-venv"
media_python = media_env / "bin/python"

if not media_python.is_file():
    subprocess.run(
        [sys.executable, "-m", "venv", "--system-site-packages", str(media_env)],
        check=True,
    )

subprocess.run(
    [str(media_python), "-m", "pip", "install", "--upgrade", "diffusers", "kokoro-onnx"],
    check=True,
)
subprocess.run(
    [str(media_python), "-c", "import torch, diffusers, soundfile, kokoro_onnx"],
    check=True,
)
print("Frag-AI media runtime ready")
